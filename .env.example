# Variables de entorno de viajes-eventos-api para Render — plantilla sin secretos.
# Copia a .env (ignorado por git) y completa los valores.
# Dashboard → servicio web (runtime Docker) → Environment → "Add from .env" y pega este archivo.
#
# No definas PORT: Render lo inyecta y la API lo lee. Las migraciones corren solas al arrancar.

# --- Base de datos -----------------------------------------------------------------------
# Render → base Postgres → Connections → "Internal Database URL" (postgresql://user:pass@host/db).
# AppConfig acepta ese formato directo; con él no hacen falta DB_USERNAME ni DB_PASSWORD.
DB_URL=postgresql://USUARIO:PASSWORD@HOST/viajes_eventos
DB_POOL_SIZE=5

# --- Seguridad ---------------------------------------------------------------------------
# Generado para producción (distinto del de desarrollo). Cambiarlo invalida las sesiones abiertas.
JWT_SECRET=  # openssl rand -base64 32
JWT_EXPIRATION_MS=86400000

# URL pública del front: se usa para CORS y para los enlaces de los correos.
FRONTEND_URL=https://viajes-eventos-ui.onrender.com
# Otros orígenes permitidos por CORS, separados por coma (p. ej. un dominio propio). Opcional.
CORS_ORIGINS=

# Cuenta administradora que se crea en el primer arranque (base vacía). Después se ignora:
# cambia la contraseña desde Mi perfil. Conviene un correo real para poder recuperar la clave.
ADMIN_BOOTSTRAP_EMAIL=admin@viajeseventos.local
ADMIN_BOOTSTRAP_PASSWORD=

# --- Correo -----------------------------------------------------------------------------
# Se configura desde la app (Configuración → Correo), guardado en la base de datos.

# --- Varios ------------------------------------------------------------------------------
LOG_LEVEL=INFO
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000
